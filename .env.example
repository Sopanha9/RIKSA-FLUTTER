# ==============================================================================
# RIKSA Flutter Mobile & Web Client Configuration
# ==============================================================================
#
# Flutter reads environment parameters at compile time via --dart-define.
#
# Example run/build commands:
#
# Local Android Emulator:
#   flutter run
#   (Defaults to http://10.0.2.2:8080)
#
# Local iOS Simulator / Desktop / Web:
#   flutter run -d chrome
#   (Defaults to http://localhost:8080)
#
# Production Build (Android APK / AAB):
#   flutter build appbundle --dart-define=API_BASE_URL=https://api.riksa.app
#
# Production Web Build:
#   flutter build web --dart-define=API_BASE_URL=https://api.riksa.app
#
API_BASE_URL=http://localhost:8080
